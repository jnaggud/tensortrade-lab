//@version=6
indicator("151 #04 SectorMomentumSkip21 | Research", overlay=false, max_bars_back=300, dynamic_requests=true)
// Portfolio SIGNAL indicator: NOT a native Strategy Tester portfolio backtest.
// Local engine accounts for simultaneous legs, costs, distributions and cash.
// Shows target weights at the current bar open, based entirely on preceding bars.
// Between rebalances these are the last target weights, not drifted live weights.
// Fixed rule: SectorMomentumSkip21. Exploratory shortlist; no broad economic qualification.
start=input.time(timestamp("01 Jan 2017 00:00 +0000"),"First eligible execution day")
if not chart.is_standard or not timeframe.isdaily or timeframe.multiplier!=1
    runtime.error("Use a standard 1-day US equity/ETF chart.")
f_stats() =>
    // Derive cash distributions on the same split-adjusted share basis as close.
    // Adjacent adjustment-factor ratios cancel any common later rescaling.
    adjustedClose=request.security(ticker.modify(syminfo.tickerid,adjustment=adjustment.dividends),timeframe.period,close,gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_off)
    priceFactor=close/adjustedClose
    impliedDistribution=na(priceFactor[1])?0.0:close[1]*(1.0-priceFactor/priceFactor[1])
    distribution=math.abs(impliedDistribution)<0.000001?0.0:impliedDistribution
    r=na(close[1])?0.0:(close+distribution)/close[1]-1.0
    logTR=ta.cum(math.log(1.0+r))
    strength=high>low?(close-low)/(high-low):0.5
    [close[1],ta.sma(close,200)[1],math.exp(logTR[1]-logTR[253])-1.0,math.exp(logTR[22]-logTR[253])-1.0,ta.stdev(r,63,false)[1]*math.sqrt(252.0),strength[1],r[1]]
var symbols=array.from("AMEX:XLB", "AMEX:XLE", "AMEX:XLF", "AMEX:XLI", "AMEX:XLK", "AMEX:XLP", "AMEX:XLU", "AMEX:XLV", "AMEX:XLY", "AMEX:SPY", "NASDAQ:IEF")
var weights=array.new_float(11,0.0)
var bool started=false
prices=array.new_float(11,na)
mas=array.new_float(11,na)
mom=array.new_float(11,na)
skipMom=array.new_float(11,na)
vols=array.new_float(11,na)
strengths=array.new_float(11,na)
returns=array.new_float(11,na)
bool ready=true
[p0,m0,v0,s0,vol0,b0,r0]=request.security("AMEX:XLB",timeframe.period,f_stats(),gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_off)
array.set(prices,0,p0)
array.set(mas,0,m0)
array.set(mom,0,v0)
array.set(skipMom,0,s0)
array.set(vols,0,vol0)
array.set(strengths,0,b0)
array.set(returns,0,r0)
ready:=ready and not na(v0) and not na(m0) and not na(vol0)
[p1,m1,v1,s1,vol1,b1,r1]=request.security("AMEX:XLE",timeframe.period,f_stats(),gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_off)
array.set(prices,1,p1)
array.set(mas,1,m1)
array.set(mom,1,v1)
array.set(skipMom,1,s1)
array.set(vols,1,vol1)
array.set(strengths,1,b1)
array.set(returns,1,r1)
ready:=ready and not na(v1) and not na(m1) and not na(vol1)
[p2,m2,v2,s2,vol2,b2,r2]=request.security("AMEX:XLF",timeframe.period,f_stats(),gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_off)
array.set(prices,2,p2)
array.set(mas,2,m2)
array.set(mom,2,v2)
array.set(skipMom,2,s2)
array.set(vols,2,vol2)
array.set(strengths,2,b2)
array.set(returns,2,r2)
ready:=ready and not na(v2) and not na(m2) and not na(vol2)
[p3,m3,v3,s3,vol3,b3,r3]=request.security("AMEX:XLI",timeframe.period,f_stats(),gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_off)
array.set(prices,3,p3)
array.set(mas,3,m3)
array.set(mom,3,v3)
array.set(skipMom,3,s3)
array.set(vols,3,vol3)
array.set(strengths,3,b3)
array.set(returns,3,r3)
ready:=ready and not na(v3) and not na(m3) and not na(vol3)
[p4,m4,v4,s4,vol4,b4,r4]=request.security("AMEX:XLK",timeframe.period,f_stats(),gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_off)
array.set(prices,4,p4)
array.set(mas,4,m4)
array.set(mom,4,v4)
array.set(skipMom,4,s4)
array.set(vols,4,vol4)
array.set(strengths,4,b4)
array.set(returns,4,r4)
ready:=ready and not na(v4) and not na(m4) and not na(vol4)
[p5,m5,v5,s5,vol5,b5,r5]=request.security("AMEX:XLP",timeframe.period,f_stats(),gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_off)
array.set(prices,5,p5)
array.set(mas,5,m5)
array.set(mom,5,v5)
array.set(skipMom,5,s5)
array.set(vols,5,vol5)
array.set(strengths,5,b5)
array.set(returns,5,r5)
ready:=ready and not na(v5) and not na(m5) and not na(vol5)
[p6,m6,v6,s6,vol6,b6,r6]=request.security("AMEX:XLU",timeframe.period,f_stats(),gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_off)
array.set(prices,6,p6)
array.set(mas,6,m6)
array.set(mom,6,v6)
array.set(skipMom,6,s6)
array.set(vols,6,vol6)
array.set(strengths,6,b6)
array.set(returns,6,r6)
ready:=ready and not na(v6) and not na(m6) and not na(vol6)
[p7,m7,v7,s7,vol7,b7,r7]=request.security("AMEX:XLV",timeframe.period,f_stats(),gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_off)
array.set(prices,7,p7)
array.set(mas,7,m7)
array.set(mom,7,v7)
array.set(skipMom,7,s7)
array.set(vols,7,vol7)
array.set(strengths,7,b7)
array.set(returns,7,r7)
ready:=ready and not na(v7) and not na(m7) and not na(vol7)
[p8,m8,v8,s8,vol8,b8,r8]=request.security("AMEX:XLY",timeframe.period,f_stats(),gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_off)
array.set(prices,8,p8)
array.set(mas,8,m8)
array.set(mom,8,v8)
array.set(skipMom,8,s8)
array.set(vols,8,vol8)
array.set(strengths,8,b8)
array.set(returns,8,r8)
ready:=ready and not na(v8) and not na(m8) and not na(vol8)
[p9,m9,v9,s9,vol9,b9,r9]=request.security("AMEX:SPY",timeframe.period,f_stats(),gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_off)
array.set(prices,9,p9)
array.set(mas,9,m9)
array.set(mom,9,v9)
array.set(skipMom,9,s9)
array.set(vols,9,vol9)
array.set(strengths,9,b9)
array.set(returns,9,r9)
ready:=ready and not na(v9) and not na(m9) and not na(vol9)
[p10,m10,v10,s10,vol10,b10,r10]=request.security("NASDAQ:IEF",timeframe.period,f_stats(),gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_off)
array.set(prices,10,p10)
array.set(mas,10,m10)
array.set(mom,10,v10)
array.set(skipMom,10,s10)
array.set(vols,10,vol10)
array.set(strengths,10,b10)
array.set(returns,10,r10)
ready:=ready and not na(v10) and not na(m10) and not na(vol10)
rebalance=ready and time>=start and (timeframe.change("M") or not started)
if rebalance
    array.fill(weights,0.0)
    started:=true
    scores=array.new_float(9,na)
    for i=0 to 8
        array.set(scores,i,array.get(skipMom,i))
    for selection=0 to 2
        best=-1.0e30
        chosen=0
        for i=0 to 8
            if array.get(scores,i)>best
                best:=array.get(scores,i)
                chosen:=i
        array.set(weights,chosen,1.0/3.0)
        array.set(scores,chosen,-1.0e30)
plot(started?array.get(weights,0)*100:na,"XLB target %",color=color.aqua,style=plot.style_stepline)
plot(started?array.get(weights,1)*100:na,"XLE target %",color=color.orange,style=plot.style_stepline)
plot(started?array.get(weights,2)*100:na,"XLF target %",color=color.lime,style=plot.style_stepline)
plot(started?array.get(weights,3)*100:na,"XLI target %",color=color.fuchsia,style=plot.style_stepline)
plot(started?array.get(weights,4)*100:na,"XLK target %",color=color.yellow,style=plot.style_stepline)
plot(started?array.get(weights,5)*100:na,"XLP target %",color=color.blue,style=plot.style_stepline)
plot(started?array.get(weights,6)*100:na,"XLU target %",color=color.red,style=plot.style_stepline)
plot(started?array.get(weights,7)*100:na,"XLV target %",color=color.teal,style=plot.style_stepline)
plot(started?array.get(weights,8)*100:na,"XLY target %",color=color.purple,style=plot.style_stepline)
plot(started?array.get(weights,9)*100:na,"SPY target %",color=color.white,style=plot.style_stepline)
plot(started?array.get(weights,10)*100:na,"IEF target %",color=color.silver,style=plot.style_stepline)
plot(started?(1.0-array.sum(weights))*100:na,"Cash target %",color=color.gray,style=plot.style_stepline)
plotshape(rebalance,title="Rebalance using preceding close",style=shape.diamond,location=location.bottom,color=color.white,size=size.tiny)
var table dashboard=table.new(position.top_right,2,14,border_width=1)
if barstate.islast
    table.cell(dashboard,0,0,"EXPLORATORY TARGETS",text_color=color.orange)
    table.cell(dashboard,1,0,"No portfolio backtest",text_color=color.orange)
    for i=0 to 10
        table.cell(dashboard,0,i+1,array.get(symbols,i),text_color=color.white)
        table.cell(dashboard,1,i+1,started?str.tostring(100*array.get(weights,i),"#.##")+"%":"Waiting",text_color=color.white)
    table.cell(dashboard,0,12,"Cash",text_color=color.white)
    table.cell(dashboard,1,12,started?str.tostring(100*(1-array.sum(weights)),"#.##")+"%":"Waiting",text_color=color.white)
    table.cell(dashboard,0,13,"Data",text_color=color.white)
    table.cell(dashboard,1,13,ready?"Complete prior bars":"Missing / warming up",text_color=ready?color.lime:color.red)
